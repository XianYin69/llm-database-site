{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM Provider Registry",
  "description": "Schema for storing LLM provider, model, and endpoint configuration data.",
  "type": "object",
  "required": ["providers", "models"],
  "properties": {
    "providers": {
      "type": "array",
      "description": "List of LLM providers",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique machine-readable identifier (e.g., 'openai', 'anthropic')",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "description": "Human-readable provider name"
          },
          "website": {
            "type": "string",
            "description": "Provider's official website URL",
            "format": "uri"
          },
          "api_base": {
            "type": "string",
            "description": "Base URL for API requests (e.g., 'https://api.openai.com')"
          },
          "auth_type": {
            "type": "string",
            "enum": ["api_key", "oauth", "none"],
            "description": "Authentication method"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "description": "List of available models",
      "items": {
        "type": "object",
        "required": ["id", "name", "provider_id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Model identifier (e.g., 'gpt-4o', 'claude-3-opus')"
          },
          "name": {
            "type": "string",
            "description": "Human-readable model name"
          },
          "provider_id": {
            "type": "string",
            "description": "References providers[].id"
          },
          "input_token_price": {
            "type": "number",
            "description": "Price per 1M input tokens (USD)",
            "minimum": 0
          },
          "output_token_price": {
            "type": "number",
            "description": "Price per 1M output tokens (USD)",
            "minimum": 0
          },
          "context_window": {
            "type": "integer",
            "description": "Maximum context window in tokens",
            "minimum": 1024
          },
          "rate_limits": {
            "type": "object",
            "description": "Rate limiting configuration",
            "properties": {
              "requests_per_minute": {
                "type": "integer",
                "description": "Max API calls per minute"
              },
              "tokens_per_minute": {
                "type": "integer",
                "description": "Max tokens processed per minute"
              }
            }
          },
          "supports_json_mode": {
            "type": "boolean",
            "description": "Whether the model supports JSON output mode"
          },
          "supports_vision": {
            "type": "boolean",
            "description": "Whether the model supports image input"
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "description": "API endpoint definitions",
      "items": {
        "type": "object",
        "required": ["id", "model_id", "path"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique endpoint identifier"
          },
          "model_id": {
            "type": "string",
            "description": "References models[].id"
          },
          "path": {
            "type": "string",
            "description": "API endpoint path (e.g., '/v1/chat/completions')"
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "DELETE"],
            "default": "POST"
          }
        }
      }
    }
  }
}
